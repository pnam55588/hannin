# Sao chép file này thành .env rồi điền giá trị thật.
# .env đã bị .gitignore chặn — không bao giờ commit.

# --- Cơ sở dữ liệu (AD-15: session pooler cổng 5432, không dùng transaction pooler) ---
# Dev bằng Docker:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hannin
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/hannin
# Prod bằng Supabase (dán chuỗi session pooler vào đây, không phải chuỗi 6543):
# DATABASE_URL=postgresql://postgres.<ref>:<mat-khau>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- Xác thực (AD-10) ---
