# uv cache + ephemeral environments, redirected here by uv.toml because the
# agent sandbox cannot write to %LOCALAPPDATA%\uv. Also self-ignored by
# .uv-cache/.gitignore — this is a belt-and-braces guard.
.uv-cache/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Node — cache và store giữ trong workspace, cùng lý do với uv.toml, xem .npmrc
node_modules/
.pnpm-store/
.npm-cache/
.pnpm-debug.log*

# Next.js
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# Test
coverage/

# OS / editor noise
Thumbs.db
Desktop.ini
*.swp
.idea/
.vscode/

# Vercel
.vercel/

# Biến môi trường — chỉ commit .env.example
.env
.env.local
.env.*.local

# Khoá bí mật - không bao giờ commit
.secrets/

.vercel
.env*
